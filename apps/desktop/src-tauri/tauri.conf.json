{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VideoCut",
  "version": "0.1.0",
  "identifier": "app.videocut.desktop",
  "build": {
    "beforeDevCommand": "node ../scripts/frontend.mjs dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node ../scripts/frontend.mjs build",
    "frontendDist": "../dist",
    "features": ["gui"]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VideoCut",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "theme": "dark"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' blob: data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
